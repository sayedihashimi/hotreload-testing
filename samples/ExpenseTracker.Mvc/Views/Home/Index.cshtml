@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <h1 class="mb-4">Expense Tracker Dashboard</h1>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">This Month's Summary</h5>
                    <h2 class="text-primary">@ViewBag.TotalSpent.ToString("C")</h2>
                    <p class="text-muted">Total Spent</p>
                    @if (ViewBag.Budget != null)
                    {
                        var budget = ViewBag.Budget as ExpenseTracker.Mvc.Models.Budget;
                        var percentUsed = budget!.TotalAmount > 0 ? (ViewBag.TotalSpent / budget.TotalAmount) * 100 : 0;
                        <div class="progress mb-2" style="height: 25px;">
                            <div class="progress-bar @(percentUsed > 90 ? "bg-danger" : percentUsed > 75 ? "bg-warning" : "bg-success")" 
                                 role="progressbar" 
                                 style="width: @percentUsed%;" 
                                 aria-valuenow="@percentUsed" 
                                 aria-valuemin="0" 
                                 aria-valuemax="100">
                                @percentUsed.ToString("F1")%
                            </div>
                        </div>
                        <p class="mb-0">Budget: @budget.TotalAmount.ToString("C")</p>
                        <p class="mb-0">Remaining: @((budget.TotalAmount - ViewBag.TotalSpent).ToString("C"))</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Quick Actions</h5>
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Create", "Expenses")" class="btn btn-primary">Add New Expense</a>
                        <a href="@Url.Action("Index", "Expenses")" class="btn btn-outline-primary">View All Expenses</a>
                        <a href="@Url.Action("Index", "Budgets")" class="btn btn-outline-secondary">Manage Budgets</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Recent Expenses</h5>
        </div>
        <div class="card-body">
            @if (ViewBag.Expenses != null && ((List<ExpenseTracker.Mvc.Models.Expense>)ViewBag.Expenses).Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Category</th>
                                <th>Amount</th>
                                <th>Payment Method</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var expense in (List<ExpenseTracker.Mvc.Models.Expense>)ViewBag.Expenses)
                            {
                                <tr>
                                    <td>@expense.Date.ToString("MMM dd, yyyy")</td>
                                    <td>@expense.Description</td>
                                    <td>
                                        @if (expense.Category != null)
                                        {
                                            <span class="badge" style="background-color: @expense.Category.Color;">
                                                @expense.Category.Icon @expense.Category.Name
                                            </span>
                                        }
                                    </td>
                                    <td class="fw-bold">@expense.Amount.ToString("C")</td>
                                    <td>@expense.PaymentMethod</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No expenses recorded this month.</p>
            }
        </div>
    </div>
</div>
