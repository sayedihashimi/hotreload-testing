@{
    ViewData["Title"] = "Monthly Report";
    var selectedMonth = (int)ViewBag.SelectedMonth;
    var selectedYear = (int)ViewBag.SelectedYear;
    var categorySpending = (Dictionary<ExpenseTracker.Mvc.Models.Category, decimal>)ViewBag.CategorySpending;
    var paymentMethodSpending = (Dictionary<ExpenseTracker.Mvc.Models.PaymentMethod, decimal>)ViewBag.PaymentMethodSpending;
}

<h1>Monthly Spending Report</h1>

<div class="row mb-3">
    <div class="col-md-12">
        <form method="get" class="row g-3">
            <div class="col-auto">
                <label for="month" class="form-label">Month</label>
                <select name="month" id="month" class="form-select">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i" selected="@(i == selectedMonth)">
                            @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)
                        </option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label for="year" class="form-label">Year</label>
                <input type="number" name="year" id="year" class="form-control" value="@selectedYear" />
            </div>
            <div class="col-auto">
                <label class="form-label">&nbsp;</label>
                <button type="submit" class="btn btn-primary d-block">View Report</button>
            </div>
        </form>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Spending by Category</h5>
            </div>
            <div class="card-body">
                @if (categorySpending.Any())
                {
                    var total = categorySpending.Sum(x => x.Value);
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Amount</th>
                                <th>%</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in categorySpending.OrderByDescending(x => x.Value))
                            {
                                var percentage = total > 0 ? (item.Value / total * 100) : 0;
                                <tr>
                                    <td>
                                        <span style="font-size: 1.5em;">@item.Key.Icon</span>
                                        @item.Key.Name
                                    </td>
                                    <td>@item.Value.ToString("C")</td>
                                    <td>@percentage.ToString("F1")%</td>
                                </tr>
                            }
                            <tr class="table-info">
                                <td><strong>Total</strong></td>
                                <td><strong>@total.ToString("C")</strong></td>
                                <td><strong>100%</strong></td>
                            </tr>
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">No expenses for this period</p>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Spending by Payment Method</h5>
            </div>
            <div class="card-body">
                @if (paymentMethodSpending.Any())
                {
                    var total = paymentMethodSpending.Sum(x => x.Value);
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Payment Method</th>
                                <th>Amount</th>
                                <th>%</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in paymentMethodSpending.OrderByDescending(x => x.Value))
                            {
                                var percentage = total > 0 ? (item.Value / total * 100) : 0;
                                <tr>
                                    <td>@item.Key</td>
                                    <td>@item.Value.ToString("C")</td>
                                    <td>@percentage.ToString("F1")%</td>
                                </tr>
                            }
                            <tr class="table-info">
                                <td><strong>Total</strong></td>
                                <td><strong>@total.ToString("C")</strong></td>
                                <td><strong>100%</strong></td>
                            </tr>
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">No expenses for this period</p>
                }
            </div>
        </div>
    </div>
</div>
