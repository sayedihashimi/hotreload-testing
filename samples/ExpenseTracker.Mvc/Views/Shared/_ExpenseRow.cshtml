@model ExpenseTracker.Mvc.Models.Expense

<tr>
    <td>@Model.Date.ToString("MMM dd, yyyy")</td>
    <td>@Model.Description</td>
    <td>
        <span class="badge" style="background-color: @Model.Category?.Color">
            @Model.Category?.Icon @Model.Category?.Name
        </span>
    </td>
    <td>@Model.Amount.ToString("C")</td>
    <td>@Model.PaymentMethod</td>
    <td>@Model.Vendor</td>
    <td>
        <a asp-controller="Expenses" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-info">Details</a>
        <a asp-controller="Expenses" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-warning">Edit</a>
        <a asp-controller="Expenses" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-danger">Delete</a>
    </td>
</tr>
