@model ExpenseTracker.Mvc.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<div class="container mt-4">
    <h1>Category Details</h1>
    <hr />

    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                <span class="fs-1 me-3">@Model.Icon</span>
                <div>
                    <h3 class="mb-0">@Model.Name</h3>
                    <span class="badge fs-6" style="background-color: @Model.Color;">@Model.Color</span>
                </div>
            </div>
            
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="text-muted">@Model.Description</p>
            }

            <div class="mt-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Expenses in this Category</h5>
        </div>
        <div class="card-body">
            @if (Model.Expenses != null && Model.Expenses.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Amount</th>
                                <th>Payment Method</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var expense in Model.Expenses.OrderByDescending(e => e.Date).Take(10))
                            {
                                <tr>
                                    <td>@expense.Date.ToString("MMM dd, yyyy")</td>
                                    <td>@expense.Description</td>
                                    <td class="fw-bold">@expense.Amount.ToString("C")</td>
                                    <td>@expense.PaymentMethod</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No expenses in this category yet.</p>
            }
        </div>
    </div>
</div>
