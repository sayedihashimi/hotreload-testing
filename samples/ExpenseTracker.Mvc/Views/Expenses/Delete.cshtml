@model ExpenseTracker.Mvc.Models.Expense

@{
    ViewData["Title"] = "Delete Expense";
}

<div class="container mt-4">
    <h1>Delete Expense</h1>
    <h3 class="text-danger">Are you sure you want to delete this expense?</h3>
    <hr />

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Description)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Description)</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Amount)</dt>
                <dd class="col-sm-9 fw-bold fs-4">@Model.Amount.ToString("C")</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Date)</dt>
                <dd class="col-sm-9">@Model.Date.ToString("MMMM dd, yyyy")</dd>

                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Category)</dt>
                <dd class="col-sm-9">
                    @if (Model.Category != null)
                    {
                        <span class="badge" style="background-color: @Model.Category.Color;">
                            @Model.Category.Icon @Model.Category.Name
                        </span>
                    }
                </dd>
            </dl>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </form>
        </div>
    </div>
</div>
