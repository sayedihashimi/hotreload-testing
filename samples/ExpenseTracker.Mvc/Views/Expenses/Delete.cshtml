@model ExpenseTracker.Mvc.Models.Expense

@{
    ViewData["Title"] = "Delete Expense";
}

<h1>Delete Expense</h1>

<h3>Are you sure you want to delete this expense?</h3>
<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">@Model.Date.ToString("MMM dd, yyyy")</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">Amount</dt>
            <dd class="col-sm-9">@Model.Amount.ToString("C")</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">
                <span class="badge" style="background-color: @Model.Category?.Color">
                    @Model.Category?.Icon @Model.Category?.Name
                </span>
            </dd>

            <dt class="col-sm-3">Vendor</dt>
            <dd class="col-sm-9">@Model.Vendor</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
