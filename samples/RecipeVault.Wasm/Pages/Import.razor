@page "/import"
@using RecipeVault.Wasm.Models
@using RecipeVault.Wasm.Services
@using System.Text.Json
@inject IRecipeRepository RecipeRepository
@inject NavigationManager Navigation

<PageTitle>Import Recipes - RecipeVault</PageTitle>

<div class="import-page">
    <h1>Import Recipes</h1>

    <div class="import-section">
        <h2>Import from JSON File</h2>
        <p>Upload a JSON file containing recipes to import them into your collection.</p>

        <InputFile OnChange="HandleFileSelected" accept=".json" class="file-input" />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">
                @errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success">
                @successMessage
            </div>
        }

        @if (isProcessing)
        {
            <p class="processing">Processing recipes...</p>
        }
    </div>

    <div class="import-section">
        <h2>JSON Format Example</h2>
        <pre class="code-block">@exampleJson</pre>
    </div>

    <div class="import-actions">
        <a href="/recipes" class="btn btn-secondary">Back to Recipes</a>
    </div>
</div>

@code {
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isProcessing = false;

    private string exampleJson = @"[
  {
    ""name"": ""Example Recipe"",
    ""description"": ""A delicious example"",
    ""prepTimeMinutes"": 15,
    ""cookTimeMinutes"": 30,
    ""servings"": 4,
    ""difficulty"": ""Easy"",
    ""imageUrl"": ""https://example.com/image.jpg"",
    ""ingredients"": [
      {
        ""name"": ""Flour"",
        ""quantity"": 2,
        ""unit"": ""cups""
      }
    ],
    ""instructions"": [
      {
        ""stepNumber"": 1,
        ""text"": ""Mix ingredients""
      }
    ],
    ""tags"": [""Quick"", ""Easy""]
  }
]";

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;
        isProcessing = true;

        try
        {
            var file = e.File;
            if (file.Size > 5 * 1024 * 1024)
            {
                errorMessage = "File size must be less than 5MB";
                return;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            var recipes = await JsonSerializer.DeserializeAsync<List<Recipe>>(stream);

            if (recipes == null || recipes.Count == 0)
            {
                errorMessage = "No valid recipes found in the file";
                return;
            }

            await RecipeRepository.ImportRecipesAsync(recipes);
            successMessage = $"Successfully imported {recipes.Count} recipe(s)!";
        }
        catch (JsonException)
        {
            errorMessage = "Invalid JSON format. Please check your file.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error importing recipes: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }
}
