@using RecipeVault.Wasm.Models

<div class="difficulty-stars">
    @for (int i = 1; i <= 4; i++)
    {
        if (i <= (int)Level + 1)
        {
            <span class="star filled">★</span>
        }
        else
        {
            <span class="star">☆</span>
        }
    }
    <span class="difficulty-text">@Level</span>
</div>

@code {
    [Parameter]
    public DifficultyLevel Level { get; set; }
}
