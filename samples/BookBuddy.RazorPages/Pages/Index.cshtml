@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1>📚 BookBuddy Dashboard</h1>

<div class="row mt-4">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Total Books</h5>
                <p class="card-text display-4">@Model.TotalBooks</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Books Read</h5>
                <p class="card-text display-4 text-success">@Model.BooksRead</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Currently Reading</h5>
                <p class="card-text display-4 text-primary">@Model.BooksReading</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Pages Read</h5>
                <p class="card-text display-4">@Model.TotalPages</p>
            </div>
        </div>
    </div>
</div>

@if (Model.CurrentGoal != null)
{
    <partial name="_ReadingProgress" model="Model.CurrentGoal" />
}

<div class="row mt-4">
    <div class="col-md-6">
        <h3>Currently Reading</h3>
        @if (Model.CurrentlyReading.Any())
        {
            <div class="list-group">
                @foreach (var book in Model.CurrentlyReading)
                {
                    <a href="/Books/Details/@book.Id" class="list-group-item list-group-item-action">
                        <div class="d-flex w-100 justify-content-between">
                            <h5 class="mb-1">@book.Title</h5>
                            <small>@book.Pages pages</small>
                        </div>
                        <p class="mb-1">by @book.Author</p>
                        <small>Started: @book.StartedDate?.ToString("MMM dd, yyyy")</small>
                    </a>
                }
            </div>
        }
        else
        {
            <p class="text-muted">No books currently being read.</p>
        }
    </div>
    
    <div class="col-md-6">
        <h3>Recently Completed</h3>
        @if (Model.RecentBooks.Any())
        {
            <div class="list-group">
                @foreach (var book in Model.RecentBooks)
                {
                    <a href="/Books/Details/@book.Id" class="list-group-item list-group-item-action">
                        <div class="d-flex w-100 justify-content-between">
                            <h5 class="mb-1">@book.Title</h5>
                            @if (book.Rating.HasValue)
                            {
                                <span>@string.Concat(Enumerable.Repeat("⭐", book.Rating.Value))</span>
                            }
                        </div>
                        <p class="mb-1">by @book.Author</p>
                        <small>Completed: @book.CompletedDate?.ToString("MMM dd, yyyy")</small>
                    </a>
                }
            </div>
        }
        else
        {
            <p class="text-muted">No completed books yet.</p>
        }
    </div>
</div>

<div class="mt-4">
    <a href="/Books" class="btn btn-primary">View All Books</a>
    <a href="/Books/Create" class="btn btn-success">Add New Book</a>
</div>

