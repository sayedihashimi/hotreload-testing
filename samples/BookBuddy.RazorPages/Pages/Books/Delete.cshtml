@page "{id:int}"
@model BookBuddy.RazorPages.Pages.Books.DeleteModel
@{
    ViewData["Title"] = "Delete Book";
}

<div class="container">
    <h1>🗑️ Delete Book</h1>

    @if (Model.Book != null)
    {
        <div class="alert alert-warning">
            <h3>Are you sure you want to delete this book?</h3>
            <p>This action cannot be undone. All reading sessions for this book will also be deleted.</p>
        </div>

        <div class="book-summary">
            <h2>@Model.Book.Title</h2>
            <p><strong>Author:</strong> @Model.Book.Author</p>
            <p><strong>Genre:</strong> @Model.Book.Genre</p>
            <p><strong>Status:</strong> @Model.Book.Status</p>
        </div>

        <form method="post">
            <input type="hidden" asp-for="Book.Id" />
            <div class="form-actions">
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                <a asp-page="Details" asp-route-id="@Model.Book.Id" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    }
    else
    {
        <p>Book not found.</p>
    }
</div>
