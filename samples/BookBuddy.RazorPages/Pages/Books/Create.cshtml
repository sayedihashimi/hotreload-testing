@page
@model BookBuddy.RazorPages.Pages.Books.CreateModel
@{
    ViewData["Title"] = "Add New Book";
}

<div class="container">
    <h1>📖 Add New Book</h1>

    <form method="post" class="book-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Book.Title"></label>
            <input asp-for="Book.Title" class="form-control" />
            <span asp-validation-for="Book.Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Book.Author"></label>
            <input asp-for="Book.Author" class="form-control" />
            <span asp-validation-for="Book.Author" class="text-danger"></span>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Book.ISBN"></label>
                <input asp-for="Book.ISBN" class="form-control" />
                <span asp-validation-for="Book.ISBN" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Book.PageCount"></label>
                <input asp-for="Book.PageCount" class="form-control" type="number" />
                <span asp-validation-for="Book.PageCount" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Book.Genre"></label>
                <input asp-for="Book.Genre" class="form-control" />
                <span asp-validation-for="Book.Genre" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Book.Status"></label>
                <select asp-for="Book.Status" class="form-control" asp-items="Html.GetEnumSelectList<ReadingStatus>()"></select>
                <span asp-validation-for="Book.Status" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Book.CoverImageUrl"></label>
            <input asp-for="Book.CoverImageUrl" class="form-control" />
            <span asp-validation-for="Book.CoverImageUrl" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Book.Notes"></label>
            <textarea asp-for="Book.Notes" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Book.Notes" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Add Book</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
