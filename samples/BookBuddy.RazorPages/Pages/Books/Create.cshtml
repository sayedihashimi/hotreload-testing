@page
@model BookBuddy.RazorPages.Pages.Books.CreateModel
@{
    ViewData["Title"] = "Add New Book";
}

<h1 class="text-3xl font-bold text-gray-800">Add New Book</h1>

<hr class="my-4" />
<div class="max-w-lg">
    <form method="post" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-red-600"></div>
        
        <div>
            <label asp-for="Book.Title" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Book.Title" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
            <span asp-validation-for="Book.Title" class="text-red-600 text-sm"></span>
        </div>
        
        <div>
            <label asp-for="Book.Author" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Book.Author" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
            <span asp-validation-for="Book.Author" class="text-red-600 text-sm"></span>
        </div>
        
        <div>
            <label asp-for="Book.Genre" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Book.Genre" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
            <span asp-validation-for="Book.Genre" class="text-red-600 text-sm"></span>
        </div>
        
        <div>
            <label asp-for="Book.Pages" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Book.Pages" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" type="number" />
            <span asp-validation-for="Book.Pages" class="text-red-600 text-sm"></span>
        </div>
        
        <div>
            <label asp-for="Book.Status" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <select asp-for="Book.Status" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" asp-items="Html.GetEnumSelectList<BookBuddy.RazorPages.Models.ReadingStatus>()">
            </select>
            <span asp-validation-for="Book.Status" class="text-red-600 text-sm"></span>
        </div>
        
        <div>
            <label asp-for="Book.StartedDate" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Book.StartedDate" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" type="date" />
            <span asp-validation-for="Book.StartedDate" class="text-red-600 text-sm"></span>
        </div>
        
        <div>
            <label asp-for="Book.CompletedDate" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Book.CompletedDate" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" type="date" />
            <span asp-validation-for="Book.CompletedDate" class="text-red-600 text-sm"></span>
        </div>
        
        <div>
            <label asp-for="Book.Rating" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <select asp-for="Book.Rating" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
                <option value="">Not Rated</option>
                <option value="1">⭐ 1 Star</option>
                <option value="2">⭐⭐ 2 Stars</option>
                <option value="3">⭐⭐⭐ 3 Stars</option>
                <option value="4">⭐⭐⭐⭐ 4 Stars</option>
                <option value="5">⭐⭐⭐⭐⭐ 5 Stars</option>
            </select>
            <span asp-validation-for="Book.Rating" class="text-red-600 text-sm"></span>
        </div>
        
        <div>
            <label asp-for="Book.Notes" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <textarea asp-for="Book.Notes" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" rows="3"></textarea>
            <span asp-validation-for="Book.Notes" class="text-red-600 text-sm"></span>
        </div>
        
        <div class="flex gap-3 pt-2">
            <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition">Create</button>
            <a href="/Books" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
