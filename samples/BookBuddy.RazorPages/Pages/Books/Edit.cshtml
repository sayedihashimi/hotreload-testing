@page "{id:int}"
@model BookBuddy.RazorPages.Pages.Books.EditModel
@{
    ViewData["Title"] = "Edit Book";
}

<div class="container">
    <h1>✏️ Edit Book</h1>

    <form method="post" class="book-form">
        <input type="hidden" asp-for="Book.Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Book.Title"></label>
            <input asp-for="Book.Title" class="form-control" />
            <span asp-validation-for="Book.Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Book.Author"></label>
            <input asp-for="Book.Author" class="form-control" />
            <span asp-validation-for="Book.Author" class="text-danger"></span>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Book.ISBN"></label>
                <input asp-for="Book.ISBN" class="form-control" />
                <span asp-validation-for="Book.ISBN" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Book.PageCount"></label>
                <input asp-for="Book.PageCount" class="form-control" type="number" />
                <span asp-validation-for="Book.PageCount" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Book.Genre"></label>
                <input asp-for="Book.Genre" class="form-control" />
                <span asp-validation-for="Book.Genre" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Book.Status"></label>
                <select asp-for="Book.Status" class="form-control" asp-items="Html.GetEnumSelectList<ReadingStatus>()"></select>
                <span asp-validation-for="Book.Status" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Book.CurrentPage"></label>
                <input asp-for="Book.CurrentPage" class="form-control" type="number" />
                <span asp-validation-for="Book.CurrentPage" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Book.Rating"></label>
                <select asp-for="Book.Rating" class="form-control">
                    <option value="">No rating</option>
                    <option value="1">⭐ 1</option>
                    <option value="2">⭐⭐ 2</option>
                    <option value="3">⭐⭐⭐ 3</option>
                    <option value="4">⭐⭐⭐⭐ 4</option>
                    <option value="5">⭐⭐⭐⭐⭐ 5</option>
                </select>
                <span asp-validation-for="Book.Rating" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Book.StartedDate"></label>
                <input asp-for="Book.StartedDate" class="form-control" type="date" />
                <span asp-validation-for="Book.StartedDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Book.FinishedDate"></label>
                <input asp-for="Book.FinishedDate" class="form-control" type="date" />
                <span asp-validation-for="Book.FinishedDate" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Book.CoverImageUrl"></label>
            <input asp-for="Book.CoverImageUrl" class="form-control" />
            <span asp-validation-for="Book.CoverImageUrl" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Book.Notes"></label>
            <textarea asp-for="Book.Notes" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Book.Notes" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-page="Details" asp-route-id="@Model.Book.Id" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
