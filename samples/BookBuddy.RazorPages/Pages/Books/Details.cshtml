@page
@model BookBuddy.RazorPages.Pages.Books.DetailsModel
@{
    ViewData["Title"] = "Book Details";
}

<h1>Book Details</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-header">
                <h3>@Model.Book.Title</h3>
            </div>
            <div class="card-body">
                <p><strong>Author:</strong> @Model.Book.Author</p>
                @if (!string.IsNullOrEmpty(Model.Book.Genre))
                {
                    <p><strong>Genre:</strong> @Model.Book.Genre</p>
                }
                @if (Model.Book.Pages.HasValue)
                {
                    <p><strong>Pages:</strong> @Model.Book.Pages</p>
                }
                <p><strong>Status:</strong> <span class="badge bg-info">@Model.Book.Status</span></p>
                
                @if (Model.Book.StartedDate.HasValue)
                {
                    <p><strong>Started:</strong> @Model.Book.StartedDate.Value.ToString("MMM dd, yyyy")</p>
                }
                
                @if (Model.Book.CompletedDate.HasValue)
                {
                    <p><strong>Completed:</strong> @Model.Book.CompletedDate.Value.ToString("MMM dd, yyyy")</p>
                }
                
                @if (Model.Book.Rating.HasValue)
                {
                    <p><strong>Rating:</strong> @string.Concat(Enumerable.Repeat("⭐", Model.Book.Rating.Value))</p>
                }
                
                @if (!string.IsNullOrEmpty(Model.Book.Notes))
                {
                    <p><strong>Notes:</strong></p>
                    <p>@Model.Book.Notes</p>
                }
            </div>
        </div>

        @if (Model.ReadingSessions.Any())
        {
            <div class="card">
                <div class="card-header">
                    <h4>Reading Sessions</h4>
                </div>
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Pages Read</th>
                                <th>Minutes</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var session in Model.ReadingSessions)
                            {
                                <tr>
                                    <td>@session.SessionDate.ToString("MMM dd, yyyy")</td>
                                    <td>@session.PagesRead</td>
                                    <td>@session.MinutesRead</td>
                                    <td>@session.Notes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="mt-2"><strong>Total Pages Read:</strong> @Model.ReadingSessions.Sum(s => s.PagesRead)</p>
                    <p><strong>Total Time:</strong> @Model.ReadingSessions.Sum(s => s.MinutesRead ?? 0) minutes</p>
                </div>
            </div>
        }
    </div>
    
    <div class="col-md-4">
        <div class="d-grid gap-2">
            <a href="/Books/Edit/@Model.Book.Id" class="btn btn-primary">Edit</a>
            <a href="/Books" class="btn btn-secondary">Back to List</a>
            <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Book.Id" 
                  onsubmit="return confirm('Are you sure you want to delete this book?');">
                <button type="submit" class="btn btn-danger w-100">Delete</button>
            </form>
        </div>
    </div>
</div>
