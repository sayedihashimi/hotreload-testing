@page
@model BookBuddy.RazorPages.Pages.Books.DetailsModel
@{
    ViewData["Title"] = "Book Details";
}

<h1 class="text-3xl font-bold text-gray-800">Book Details</h1>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
    <div class="md:col-span-2">
        <div class="bg-white rounded-lg shadow mb-4">
            <div class="border-b px-6 py-4">
                <h3 class="text-xl font-semibold text-gray-800">@Model.Book.Title</h3>
            </div>
            <div class="px-6 py-4 space-y-2">
                <p><strong class="text-gray-600">Author:</strong> @Model.Book.Author</p>
                @if (!string.IsNullOrEmpty(Model.Book.Genre))
                {
                    <p><strong class="text-gray-600">Genre:</strong> @Model.Book.Genre</p>
                }
                @if (Model.Book.Pages.HasValue)
                {
                    <p><strong class="text-gray-600">Pages:</strong> @Model.Book.Pages</p>
                }
                <p><strong class="text-gray-600">Status:</strong> <span class="inline-block px-2 py-1 text-xs font-semibold rounded-full bg-cyan-500 text-white">@Model.Book.Status</span></p>
                
                @if (Model.Book.StartedDate.HasValue)
                {
                    <p><strong class="text-gray-600">Started:</strong> @Model.Book.StartedDate.Value.ToString("MMM dd, yyyy")</p>
                }
                
                @if (Model.Book.CompletedDate.HasValue)
                {
                    <p><strong class="text-gray-600">Completed:</strong> @Model.Book.CompletedDate.Value.ToString("MMM dd, yyyy")</p>
                }
                
                @if (Model.Book.Rating.HasValue)
                {
                    <p><strong class="text-gray-600">Rating:</strong> @string.Concat(Enumerable.Repeat("⭐", Model.Book.Rating.Value))</p>
                }
                
                @if (!string.IsNullOrEmpty(Model.Book.Notes))
                {
                    <p><strong class="text-gray-600">Notes:</strong></p>
                    <p class="text-gray-700">@Model.Book.Notes</p>
                }
            </div>
        </div>

        @if (Model.ReadingSessions.Any())
        {
            <div class="bg-white rounded-lg shadow">
                <div class="border-b px-6 py-4">
                    <h4 class="text-lg font-semibold text-gray-800">Reading Sessions</h4>
                </div>
                <div class="px-6 py-4">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="border-b">
                                <th class="py-2 text-sm font-semibold text-gray-600">Date</th>
                                <th class="py-2 text-sm font-semibold text-gray-600">Pages Read</th>
                                <th class="py-2 text-sm font-semibold text-gray-600">Minutes</th>
                                <th class="py-2 text-sm font-semibold text-gray-600">Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var session in Model.ReadingSessions)
                            {
                                <tr class="border-b last:border-b-0">
                                    <td class="py-2">@session.SessionDate.ToString("MMM dd, yyyy")</td>
                                    <td class="py-2">@session.PagesRead</td>
                                    <td class="py-2">@session.MinutesRead</td>
                                    <td class="py-2">@session.Notes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="mt-3"><strong class="text-gray-600">Total Pages Read:</strong> @Model.ReadingSessions.Sum(s => s.PagesRead)</p>
                    <p><strong class="text-gray-600">Total Time:</strong> @Model.ReadingSessions.Sum(s => s.MinutesRead ?? 0) minutes</p>
                </div>
            </div>
        }
    </div>
    
    <div>
        <div class="flex flex-col gap-2">
            <a href="/Books/Edit/@Model.Book.Id" class="block text-center px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition">Edit</a>
            <a href="/Books" class="block text-center px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition">Back to List</a>
            <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Book.Id" 
                  onsubmit="return confirm('Are you sure you want to delete this book?');">
                <button type="submit" class="w-full px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition">Delete</button>
            </form>
        </div>
    </div>
</div>
