@using RecipeVault.Server.Data.Models

<div class="difficulty-stars">
    @for (int i = 1; i <= 4; i++)
    {
        <span class="star @(i <= (int)Difficulty + 1 ? "filled" : "empty")">★</span>
    }
    <span class="difficulty-label">@Difficulty</span>
</div>

@code {
    [Parameter]
    public DifficultyLevel Difficulty { get; set; }
}
