@page "/"
@using ComponentCraft.Components.Buttons
@using ComponentCraft.Components.Cards
@using ComponentCraft.Components.Layout

<PageTitle>ComponentCraft - UI Component Gallery</PageTitle>

<PageHeader Title="ComponentCraft" Subtitle="A Beautiful Blazor Component Library">
    <Actions>
        <PrimaryButton>Get Started</PrimaryButton>
    </Actions>
</PageHeader>

<div class="container" style="padding: 2rem;">
    <div class="gallery-intro" style="text-align: center; margin-bottom: 3rem;">
        <h2>Welcome to ComponentCraft</h2>
        <p style="color: var(--cc-text-secondary); max-width: 600px; margin: 1rem auto;">
            A comprehensive collection of reusable Blazor UI components built for Hot Reload testing.
            Explore buttons, cards, forms, and feedback components with customizable themes.
        </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 3rem;">
        <InfoCard Title="Buttons">
            <p>Primary, Secondary, and Icon buttons with full customization.</p>
            <PrimaryButton CssClass="mt-2">
                <a href="/components/buttons" style="color: inherit; text-decoration: none;">View Buttons →</a>
            </PrimaryButton>
        </InfoCard>

        <InfoCard Title="Cards">
            <p>Info Cards, Stat Cards, and Profile Cards for displaying content.</p>
            <PrimaryButton CssClass="mt-2">
                <a href="/components/cards" style="color: inherit; text-decoration: none;">View Cards →</a>
            </PrimaryButton>
        </InfoCard>

        <InfoCard Title="Forms">
            <p>Text Inputs, Selects, and Date Pickers with validation support.</p>
            <PrimaryButton CssClass="mt-2">
                <a href="/components/forms" style="color: inherit; text-decoration: none;">View Forms →</a>
            </PrimaryButton>
        </InfoCard>

        <InfoCard Title="Feedback">
            <p>Alerts, Toasts, Loading Spinners, and Progress Bars.</p>
            <PrimaryButton CssClass="mt-2">
                <a href="/components/feedback" style="color: inherit; text-decoration: none;">View Feedback →</a>
            </PrimaryButton>
        </InfoCard>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;">
        <StatCard Icon="👥" Value="15+" Label="Components" Change="+3 this week" ChangeClass="text-success" />
        <StatCard Icon="🎨" Value="100%" Label="Customizable" />
        <StatCard Icon="⚡" Value="Fast" Label="Hot Reload Ready" />
        <StatCard Icon="📱" Value="Responsive" Label="Mobile Friendly" />
    </div>
</div>
