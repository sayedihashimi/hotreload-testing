@model ExpenseTracker.Mvc.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container mt-4">
    <h1>Delete Category</h1>
    <h3 class="text-danger">Are you sure you want to delete this category?</h3>
    <hr />

    <div class="card">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                <span class="fs-1 me-3">@Model.Icon</span>
                <div>
                    <h4 class="mb-0">@Model.Name</h4>
                    <span class="badge" style="background-color: @Model.Color;">@Model.Color</span>
                </div>
            </div>
            
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="text-muted">@Model.Description</p>
            }

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </form>
        </div>
    </div>
</div>
