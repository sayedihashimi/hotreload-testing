@model ExpenseTracker.Mvc.Models.Budget

@{
    ViewData["Title"] = "Budget Details";
    var categorySpending = ViewBag.CategorySpending as Dictionary<int, decimal>;
}

<div class="container mt-4">
    <h1>Budget Details</h1>
    <hr />

    <div class="card mb-4">
        <div class="card-body">
            <h3>@Model.Name</h3>
            <p class="text-muted">
                @Model.StartDate.ToString("MMMM dd, yyyy") - @Model.EndDate.ToString("MMMM dd, yyyy")
            </p>
            
            <div class="row mt-3">
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6>Total Budget</h6>
                            <h4 class="text-primary">@Model.TotalAmount.ToString("C")</h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Category Budgets</h5>
        </div>
        <div class="card-body">
            @if (Model.CategoryBudgets != null && Model.CategoryBudgets.Any())
            {
                @foreach (var categoryBudget in Model.CategoryBudgets)
                {
                    var spent = categorySpending != null && categorySpending.ContainsKey(categoryBudget.CategoryId) 
                        ? categorySpending[categoryBudget.CategoryId] 
                        : 0;
                    var percentUsed = categoryBudget.AllocatedAmount > 0 ? (spent / categoryBudget.AllocatedAmount) * 100 : 0;
                    
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                @if (categoryBudget.Category != null)
                                {
                                    <span class="badge fs-6" style="background-color: @categoryBudget.Category.Color;">
                                        @categoryBudget.Category.Icon @categoryBudget.Category.Name
                                    </span>
                                }
                            </div>
                            <div class="text-end">
                                <strong>@spent.ToString("C")</strong> / @categoryBudget.AllocatedAmount.ToString("C")
                            </div>
                        </div>
                        <div class="progress" style="height: 20px;">
                            <div class="progress-bar @(percentUsed > 90 ? "bg-danger" : percentUsed > 75 ? "bg-warning" : "bg-success")" 
                                 role="progressbar" 
                                 style="width: @Math.Min(percentUsed, 100)%;" 
                                 aria-valuenow="@percentUsed" 
                                 aria-valuemin="0" 
                                 aria-valuemax="100">
                                @percentUsed.ToString("F1")%
                            </div>
                        </div>
                        <small class="text-muted">
                            Remaining: @((categoryBudget.AllocatedAmount - spent).ToString("C"))
                        </small>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No category budgets allocated.</p>
            }
        </div>
    </div>
</div>
