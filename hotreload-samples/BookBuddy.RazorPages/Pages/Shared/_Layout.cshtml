<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookBuddy.RazorPages</title>
    <script type="importmap"></script>
    <script src="~/js/tailwindcss-browser.js"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen flex flex-col bg-gray-50">
    <header>
        <nav class="bg-white border-b shadow-sm mb-6">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between h-14 items-center">
                    <a class="text-xl font-bold text-gray-800 hover:text-indigo-600" asp-area="" asp-page="/Index">📚 BookBuddy</a>
                    <div class="flex space-x-6">
                        <a class="text-gray-700 hover:text-indigo-600 font-medium" asp-area="" asp-page="/Index">Home</a>
                        <a class="text-gray-700 hover:text-indigo-600 font-medium" asp-area="" asp-page="/Books/Index">Books</a>
                        <a class="text-gray-700 hover:text-indigo-600 font-medium" asp-area="" asp-page="/Privacy">Privacy</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex-grow w-full">
        <main role="main" class="pb-6">
            @RenderBody()
        </main>
    </div>

    <footer class="border-t bg-white text-gray-500 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            &copy; 2026 - BookBuddy.RazorPages - <a asp-area="" asp-page="/Privacy" class="text-indigo-600 hover:underline">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
