@page "/recipes/create"
@using Microsoft.EntityFrameworkCore
@using RecipeVault.Server.Data
@using RecipeVault.Server.Models
@inject RecipeContext DbContext
@inject NavigationManager Navigation

<PageTitle>Create Recipe</PageTitle>

<div class="container py-4">
    <h1>Create New Recipe</h1>

    <EditForm Model="@recipe" OnValidSubmit="@HandleSubmit">
        <div class="row">
            <div class="col-md-8">
                <div class="card mb-3">
                    <div class="card-body">
                        <h5>Basic Information</h5>
                        <div class="mb-3">
                            <label class="form-label">Recipe Name</label>
                            <InputText @bind-Value="recipe.Name" class="form-control" placeholder="Enter recipe name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputTextArea @bind-Value="recipe.Description" class="form-control" rows="3" placeholder="Brief description" />
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Prep Time (min)</label>
                                <InputNumber @bind-Value="recipe.PrepTimeMinutes" class="form-control" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Cook Time (min)</label>
                                <InputNumber @bind-Value="recipe.CookTimeMinutes" class="form-control" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Servings</label>
                                <InputNumber @bind-Value="recipe.Servings" class="form-control" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Difficulty</label>
                                <InputSelect @bind-Value="recipe.Difficulty" class="form-select">
                                    <option value="@DifficultyLevel.Easy">Easy</option>
                                    <option value="@DifficultyLevel.Medium">Medium</option>
                                    <option value="@DifficultyLevel.Hard">Hard</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Image URL</label>
                                <InputText @bind-Value="recipe.ImageUrl" class="form-control" placeholder="/images/recipe.jpg" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <InputCheckbox @bind-Value="recipe.IsFeatured" class="form-check-input" id="featured" />
                                <label class="form-check-label" for="featured">
                                    Feature this recipe
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-body">
                        <IngredientList Ingredients="@recipe.Ingredients" Editable="true" />
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-body">
                        <InstructionSteps Instructions="@recipe.Instructions" Editable="true" />
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card mb-3">
                    <div class="card-body">
                        <TagSelector AvailableTags="@availableTags" @bind-SelectedTagIds="selectedTagIds" />
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">Create Recipe</button>
                    <a href="/recipes" class="btn btn-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </EditForm>
</div>

@code {
    private Recipe recipe = new()
    {
        Difficulty = DifficultyLevel.Easy,
        Servings = 4,
        ImageUrl = "/images/placeholder.jpg",
        CreatedDate = DateTime.UtcNow
    };

    private List<Tag> availableTags = new();
    private List<int> selectedTagIds = new();

    protected override async Task OnInitializedAsync()
    {
        availableTags = await DbContext.Tags.ToListAsync();
    }

    private async Task HandleSubmit()
    {
        DbContext.Recipes.Add(recipe);
        await DbContext.SaveChangesAsync();

        foreach (var tagId in selectedTagIds)
        {
            DbContext.RecipeTags.Add(new RecipeTag
            {
                RecipeId = recipe.Id,
                TagId = tagId
            });
        }
        await DbContext.SaveChangesAsync();

        Navigation.NavigateTo($"/recipes/{recipe.Id}");
    }
}
