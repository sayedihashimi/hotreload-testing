<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Contacts</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen flex flex-col bg-gray-50 text-gray-800">
    <header>
        <nav class="bg-white border-b shadow-sm">
            <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
                <a class="text-xl font-bold text-gray-900" asp-area="" asp-page="/Index">Contacts</a>
                <div class="flex gap-6">
                    <a class="text-gray-600 hover:text-gray-900" asp-area="" asp-page="/Index">Home</a>
                    <a class="text-gray-600 hover:text-gray-900" asp-area="" asp-page="/Privacy">Privacy</a>
                </div>
            </div>
        </nav>
    </header>
    <div class="max-w-7xl mx-auto px-4 py-6 flex-1 w-full">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-t bg-white text-gray-500 text-sm">
        <div class="max-w-7xl mx-auto px-4 py-4">
            &copy; 2026 - Contacts - <a class="hover:text-gray-700 underline" asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
