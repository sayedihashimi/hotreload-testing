@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center mb-12">
    <h1 class="text-4xl font-bold text-gray-900">Contacts</h1>
    <p class="mt-3 text-lg text-gray-600">A simple contact manager to organize your personal and professional connections.</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="bg-white rounded-lg shadow p-6 text-center">
        <h2 class="text-xl font-semibold mb-2">📇 Manage Contacts</h2>
        <p class="text-gray-600">Add, edit, and remove contacts with details like name, email, phone number, and address.</p>
    </div>
    <div class="bg-white rounded-lg shadow p-6 text-center">
        <h2 class="text-xl font-semibold mb-2">🔍 Search &amp; Filter</h2>
        <p class="text-gray-600">Quickly find the contact you need with powerful search and filtering capabilities.</p>
    </div>
    <div class="bg-white rounded-lg shadow p-6 text-center">
        <h2 class="text-xl font-semibold mb-2">🏷️ Organize with Groups</h2>
        <p class="text-gray-600">Categorize your contacts into groups like Family, Friends, Work, and more.</p>
    </div>
</div>
